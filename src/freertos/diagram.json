{
  "version": 1,
  "author": "D22CQDT01-N TRAN NGUYEN AN SON",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-mpu6050",
      "id": "mpu",
      "top": -100,
      "left": 320,
      "attrs": { "accelX": "0", "accelY": "0", "accelZ": "1" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": -80,
      "left": 480,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": -80,
      "left": 540,
      "attrs": { "color": "red", "label": "FAULT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 20,
      "left": 480,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 20,
      "left": 540,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX",      "$serialMonitor:RX", "",       [] ],
    [ "esp:RX",      "$serialMonitor:TX", "",       [] ],
    [ "esp:21",      "mpu:SDA",           "blue",   [] ],
    [ "esp:22",      "mpu:SCL",           "yellow", [] ],
    [ "esp:3V3",     "mpu:VCC",           "red",    [] ],
    [ "esp:GND.1",   "mpu:GND",           "black",  [] ],
    [ "esp:D2",      "r1:1",              "green",  [] ],
    [ "r1:2",        "led_green:A",       "green",  [] ],
    [ "led_green:C", "esp:GND.2",         "black",  [] ],
    [ "esp:D4",      "r2:1",              "red",    [] ],
    [ "r2:2",        "led_red:A",         "red",    [] ],
    [ "led_red:C",   "esp:GND.2",         "black",  [] ]
  ],
  "dependencies": {}
}
